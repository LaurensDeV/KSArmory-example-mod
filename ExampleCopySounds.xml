<!--
  Generated from KSArmory c138556f35 (2026-10-22) by tools/export-example-copy.py. Do not edit:
  the live file is src/KSArmory/KSArmorySounds.xml
  https://github.com/LaurensDeV/KSArmory/blob/c138556f35eba603f9de60320a744852f5b3bd57/src/KSArmory/KSArmorySounds.xml
  Every Id is KSArmory's renamed from KSArmory_ to ExampleCopy_, so this loads beside it.
-->
<!--
  The mod's own sounds. Modelled on Core's Sounds.xml, which is the only documentation this format
  has.

  The .wav files beside this are recordings, each cut by a script so it can be re-cut, with where it
  came from in tools/audio/README.md: the Phalanx's, and the 5"/54 Mk 42's gunshot. A warhead's burst
  is KSA's own explosion and brings its own sound, so none is declared here.

  Mono on purpose. The engine spatialises the source, and a stereo file has nothing to spatialise:
  it arrives already mixed and sits in the listener's head.
-->
<Assets>
    <!--
      Every gun sound here is Priority 110, above everything Core plays: its explosions are 123 and
      124, its engines 125, and anything undeclared 128, where lower wins. FMOD mixes only 64 voices
      for real and silences the least important of the rest, so at 128 a gun firing through a string
      of kills went quiet beside the explosions it was causing. There are only a few gun channels at
      once, so the explosions keep every other voice.
    -->

    <!--
      Cyclic cannon fire. Quieter and shorter-ranged than a warhead: a gun is loud where you are
      standing and a detonation is loud from the next county.
    -->
    <SpatialSoundData Id="ExampleCopyCannonSpatialData">
        <VolumeRange Min="25" Max="6000" />
        <TwoDRange Min="3" Max="14" />
    </SpatialSoundData>

    <!--
      A burst of gunfire is THREE sounds, and the engine already knows it: the barrels coming up to
      speed, steady fire for as long as the trigger is held, and the echoes arriving back off the
      terrain afterwards. One looping sample gets the spin-up on every pass and never gets the
      tail, which is what makes a synthesised loop read as a texture rather than as an event.

      Cut from a recording by tools/cut-cannon.py, whose cut points are measured off the envelope
      rather than typed in. See tools/audio/README.md, which also carries the licence question
      that has to be settled before a release ships these.

      Same shape as Core's DefaultEngineSoundBehavior, which is a CompoundSound for the same
      reason an engine is: it starts, it runs, it stops.
    -->
    <Sound Id="ExampleCopyCannonSpin" ChannelId="ExternalChannel" Priority="110">
        <SoundFile Path="Sounds/ExampleCopy_Cannon_Spin.wav" Volume="1.0"/>
        <SpatialSoundData Id="ExampleCopyCannonSpatialData" />
    </Sound>

    <Sound Id="ExampleCopyCannonLoop" ChannelId="ExternalChannel" Priority="110">
        <SoundFile Path="Sounds/ExampleCopy_Cannon_Loop.wav" Volume="1.0">
            <Loop />
        </SoundFile>
        <SpatialSoundData Id="ExampleCopyCannonSpatialData" />
    </Sound>

    <Sound Id="ExampleCopyCannonTail" ChannelId="ExternalChannel" Priority="110">
        <SoundFile Path="Sounds/ExampleCopy_Cannon_Tail.wav" Volume="1.0"/>
        <SpatialSoundData Id="ExampleCopyCannonSpatialData" />
    </Sound>

    <CompoundSound Id="ExampleCopyCannon">
        <StartSound Id="ExampleCopyCannonSpin" />
        <Sound Id="ExampleCopyCannonLoop" />
        <StopSound Id="ExampleCopyCannonTail" />
    </CompoundSound>

    <!--
      The 5"/54 Mk 42, cut by tools/mk42-sounds.py. Heard further than the Phalanx: a five-inch
      gun's gunshot carries a long way further than a 20 mm one.
    -->
    <SpatialSoundData Id="ExampleCopyMk42SpatialData">
        <VolumeRange Min="60" Max="12000" />
        <TwoDRange Min="4" Max="18" />
    </SpatialSoundData>

    <!-- One per round, pitched a little each time so forty a minute is not one sample forty times. -->
    <Sound Id="ExampleCopyMk42Gunshot" ChannelId="ExternalChannel" Priority="110">
        <SoundFile Path="Sounds/ExampleCopy_Mk42_Gunshot.wav" Volume="1.0"/>
        <SpatialSoundData Id="ExampleCopyMk42SpatialData" />
        <Pitch Min="0.96" Max="1.04" />
    </Sound>

    <!-- The M197, cut by tools/m197-sounds.py. No spin-up: the recording has none. -->
    <Sound Id="ExampleCopyM197Loop" ChannelId="ExternalChannel" Priority="110">
        <SoundFile Path="Sounds/ExampleCopy_M197_Loop.wav" Volume="1.0">
            <Loop />
        </SoundFile>
        <SpatialSoundData Id="ExampleCopyCannonSpatialData" />
    </Sound>

    <Sound Id="ExampleCopyM197Tail" ChannelId="ExternalChannel" Priority="110">
        <SoundFile Path="Sounds/ExampleCopy_M197_Tail.wav" Volume="1.0"/>
        <SpatialSoundData Id="ExampleCopyCannonSpatialData" />
    </Sound>

    <CompoundSound Id="ExampleCopyM197">
        <Sound Id="ExampleCopyM197Loop" />
        <StopSound Id="ExampleCopyM197Tail" />
    </CompoundSound>

</Assets>
