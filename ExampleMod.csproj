<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- StarMap loads "<EntryAssembly>.dll" from mod.toml, so this name must match it. -->
    <AssemblyName>ExampleMod</AssemblyName>
    <RootNamespace>ExampleMod</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!--
    Two references, and neither is a game assembly. That is the whole point of KSArmory taking a
    string rather than a profile: constructing a LauncherProfile in C# would need double3 from
    Brutal.Core.Numerics, which is RocketWerkz's and not redistributable, and a pack would then
    need a KSA install to compile. This one needs a .NET SDK.

    KSArmory.dll comes from its release archive; StarMap.API.dll ships with the loader. Point
    either somewhere else with -p:KSArmoryDir=... / -p:StarMapDir=... if yours are elsewhere.
  -->
  <PropertyGroup>
    <KSArmoryDir Condition="'$(KSArmoryDir)' == ''">$(MSBuildThisFileDirectory)../KSArmory/src/KSArmory/bin/Release/net10.0</KSArmoryDir>
    <StarMapDir Condition="'$(StarMapDir)' == ''">$(MSBuildThisFileDirectory)../KSArmory/Import</StarMapDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Private=false: both are already loaded in the process. Shipping a second copy of KSArmory.dll
      would land it in this mod's own load context, and the PackResult we handed back would then be
      a different type from the one KSArmory returned.
    -->
    <Reference Include="$(KSArmoryDir)/KSArmory.dll" Private="false" />
    <Reference Include="$(StarMapDir)/StarMap.API.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="mod.toml;*.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Meshes\**\*.glb;Textures\**\*.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
